# ===========================================
# InterviewPrep Environment Variables
# ===========================================
# IMPORTANT: Copy this file to .env.local and fill in real values
# NEVER commit .env.local or any file with real secrets

# ===========================================
# Database (Neon PostgreSQL)
# ===========================================
# Server-only - DO NOT prefix with NEXT_PUBLIC_
DRIZZLE_DB_URL=postgresql://user:password@host/database

# ===========================================
# Authentication (NextAuth + Google OAuth)
# ===========================================
# Server-only
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXTAUTH_SECRET=generate-a-random-32-char-string
NEXTAUTH_URL=http://localhost:3000

# ===========================================
# AI Services (Gemini)
# ===========================================
# Server-only - DO NOT prefix with NEXT_PUBLIC_
GEMINI_API_KEY=your-gemini-api-key

# Also used by some modules (legacy compatibility)
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# ===========================================
# AWS S3
# ===========================================
# Server-only - DO NOT prefix with NEXT_PUBLIC_
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=your-bucket-name

# ===========================================
# Pinecone Vector Database
# ===========================================
# Server-only
PINECONE_API_KEY=your-pinecone-api-key

# ===========================================
# Stream Video SDK
# ===========================================
# The API key CAN be public (like Firebase keys)
NEXT_PUBLIC_STREAM_API_KEY=your-stream-api-key
# The secret key MUST be server-only
GET_STREAM_SECRET_KEY=your-stream-secret-key

# ===========================================
# App Configuration
# ===========================================
# Number of interview questions to generate (can be public)
NEXT_PUBLIC_INTERVIEW_QUESTION_COUNT=5

# ===========================================
# Optional: Rate Limiting (Upstash Redis)
# ===========================================
# Uncomment if using rate limiting
# UPSTASH_REDIS_REST_URL=your-upstash-url
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
